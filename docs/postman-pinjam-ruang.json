              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Ruang Seminar\",\n  \"deskripsi\": \"Ruang untuk seminar dan presentasi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/room-categories"
          }
        },
        {
          "name": "Ubah Kategori Ruang",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Ruang Kelas\",\n  \"deskripsi\": \"Ruang untuk perkuliahan\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/room-categories/1"
          }
        },
        {
          "name": "Hapus Kategori Ruang",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/room-categories/1"
          }
        }
      ]
    },
    {
      "name": "Ruang",
      "item": [
        {
          "name": "Daftar Ruang dengan Filter",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/rooms?kategori=&status=tersedia&kapasitas_min=20&search=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "rooms"
              ],
              "query": [
                {
                  "key": "kategori",
                  "value": ""
                },
                {
                  "key": "status",
                  "value": "tersedia"
                },
                {
                  "key": "kapasitas_min",
                  "value": "20"
                },
                {
                  "key": "search",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "Detail Ruang",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/rooms/1"
          }
        },
        {
          "name": "Tambah Ruang",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_category_id\": 1,\n  \"kode\": \"RK-UJI\",\n  \"nama\": \"Ruang Uji\",\n  \"kapasitas\": 30,\n  \"lokasi\": \"Gedung Uji\",\n  \"fasilitas\": \"Proyektor, AC\",\n  \"deskripsi\": \"Ruang untuk pengujian API\",\n  \"status\": \"tersedia\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/rooms"
          }
        },
        {
          "name": "Ubah Ruang",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_category_id\": 1,\n  \"kode\": \"RK-101\",\n  \"nama\": \"Ruang Kelas 101\",\n  \"kapasitas\": 40,\n  \"lokasi\": \"Gedung A Lantai 1\",\n  \"fasilitas\": \"Proyektor, AC, papan tulis\",\n  \"deskripsi\": \"Ruang perkuliahan\",\n  \"status\": \"tersedia\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/rooms/1"
          }
        },
        {
          "name": "Hapus Ruang",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/rooms/1"
          }
        },
        {
          "name": "Cek Ketersediaan Ruang",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/rooms/1/availability?tanggal={{today}}"
          }
        }
      ]
    },
    {
      "name": "Peminjaman",
      "item": [
