                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_id\": 2,\n  \"tanggal\": \"{{today}}\",\n  \"jam_mulai\": \"11:00\",\n  \"jam_selesai\": \"12:00\",\n  \"keperluan\": \"Pengujian pengajuan sukses\",\n  \"jumlah_peserta\": 10\n}",
